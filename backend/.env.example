# Copiar este archivo como .env y ajustar los valores.
# El .env real NO se sube al repositorio (esta en .gitignore).

PORT=3000

# --- Conexion a MongoDB ---
# Opcion A (local): Mongo corriendo en tu maquina.
#   MONGODB_URI=mongodb://localhost:27017/gestor_gastos
#
# Opcion B (Atlas): pegar la cadena que da Atlas y REEMPLAZAR:
#   - <password> por la contrasena del usuario de base de datos
#   - agregar el nombre de la base (gestor_gastos) ANTES del "?"
#     (sin el, Atlas usa una base llamada "test" por defecto)
#   Ejemplo del formato:
#   MONGODB_URI=mongodb+srv://miusuario:<password>@cluster0.abcde.mongodb.net/gestor_gastos?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/gestor_gastos

NODE_ENV=development
